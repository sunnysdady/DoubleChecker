# AI 层配置示例 —— 复制成 ai.env 并填上你的 key（ai.env 已被 .gitignore，不会进仓库）
#   cp ai.env.example ai.env && nano ai.env
# 改完重启服务即可生效： systemctl restart ocr-proofread
AI_PROVIDER=deepseek
AI_API_KEY=填你的DeepSeekKey
# 可选：指定模型 / 端点 / 控成本
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com
# AI_MAX_CHUNKS=12
